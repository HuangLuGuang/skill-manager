FROM buildpack-deps:bookworm AS nsjail-builder

ARG NSJAIL_VERSION=3.6
ARG APT_PROXY
ARG GIT_PROXY

RUN if [ -n "$APT_PROXY" ]; then printf 'Acquire::http::Proxy "%s";\n' "$APT_PROXY" > /etc/apt/apt.conf.d/99build-proxy; fi && \
    apt-get -o Acquire::Retries=5 update && \
    apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      autoconf \
      bison \
      ca-certificates \
      flex \
      g++ \
      gcc \
      git \
      libnl-route-3-dev \
      libprotobuf-dev \
      libtool \
      make \
      pkg-config \
      protobuf-compiler && \
    rm -f /etc/apt/apt.conf.d/99build-proxy && \
    if [ -n "$GIT_PROXY" ]; then \
      git -c http.proxy="$GIT_PROXY" clone --branch "${NSJAIL_VERSION}" --depth 1 \
        https://github.com/google/nsjail.git /src/nsjail; \
    else \
      git clone --branch "${NSJAIL_VERSION}" --depth 1 \
        https://github.com/google/nsjail.git /src/nsjail; \
    fi && \
    if [ -n "$GIT_PROXY" ]; then \
      git -C /src/nsjail -c http.proxy="$GIT_PROXY" submodule update --init --depth 1; \
    else \
      git -C /src/nsjail submodule update --init --depth 1; \
    fi && \
    make -C /src/nsjail -j"$(nproc)"


FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

ARG APT_PROXY
ARG PYPI_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

RUN if [ -n "$APT_PROXY" ]; then printf 'Acquire::http::Proxy "%s";\n' "$APT_PROXY" > /etc/apt/apt.conf.d/99build-proxy; fi && \
    apt-get -o Acquire::Retries=5 update && \
    apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      python3 \
      python3-pip \
      python3-venv \
      nodejs \
      libnl-route-3-200 \
      libprotobuf32 \
      ca-certificates && \
    rm -f /etc/apt/apt.conf.d/99build-proxy && \
    rm -rf /var/lib/apt/lists/*

COPY --from=nsjail-builder /src/nsjail/nsjail /usr/local/bin/nsjail

RUN python3 -m venv /opt/sandbox-venv && \
    /opt/sandbox-venv/bin/pip install --index-url "$PYPI_INDEX" uv && \
    UV_DEFAULT_INDEX="$PYPI_INDEX" /opt/sandbox-venv/bin/uv pip install \
      --python /opt/sandbox-venv/bin/python \
      fastapi \
      uvicorn \
      "pydantic>=2.6.0" \
      numpy \
      pandas \
      requests \
      httpx \
      PyYAML \
      python-frontmatter \
      rich \
      click

ENV PATH="/opt/sandbox-venv/bin:${PATH}"

RUN mkdir -p /workspace && chmod 0555 /workspace

WORKDIR /app

COPY services/isolated-sandbox-service/app.py ./

ENV SANDBOX_SERVICE_BACKEND=nsjail \
    SANDBOX_SERVICE_WORK_ROOT=/tmp/isolated-sandbox-service \
    SANDBOX_SERVICE_PYTHON_BIN=/opt/sandbox-venv/bin/python \
    SANDBOX_SERVICE_NODE_BIN=node \
    SANDBOX_SERVICE_NSJAIL_BIN=nsjail

EXPOSE 8194

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8194"]
