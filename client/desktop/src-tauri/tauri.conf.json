{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "瑞数智能体安全治理客户端",
  "version": "0.1.0",
  "identifier": "com.agent-manager.client",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "瑞数智能体安全治理客户端",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app"
    ],
    "externalBin": [
      "bin/agent-manager-client"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Manage approved Skills across local AI Agents"
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
