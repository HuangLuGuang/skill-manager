      "known_limitations": [
        {
          "code": "dynamic_target_required",
          "zh-CN": "Agent Scan 是动态黑盒测试，需要可访问的目标和评估模型。",
          "en-US": "Agent Scan is dynamic black-box testing and requires a reachable target plus an evaluation model."
        },
        {
          "code": "custom_response_transform_required",
          "zh-CN": "非已知响应格式的自定义 HTTP 目标必须显式配置 transform_response。",
          "en-US": "Custom HTTP targets require an explicit transform_response path when the response is not a known provider format."
        },
        {
          "code": "upstream_score_is_signal",
          "zh-CN": "上游风险分数只作为 Agent Manager 策略汇总信号，不等同于银行验收评分。",
          "en-US": "Upstream risk scores are inputs to Agent Manager policy aggregation and are not bank acceptance scores."
        },
        {
          "code": "platform_controls_required",
          "zh-CN": "隔离 Worker 仍必须执行 Agent Manager 的 SSRF、凭据、预算、审批和环境控制。",
          "en-US": "The isolated worker must apply Agent Manager SSRF, credential, budget, approval and environment controls."
        },
        {
          "code": "insecure_tls_disabled",
          "zh-CN": "Agent Manager 集成基线不启用不安全 TLS 模式。",
          "en-US": "Insecure TLS is not enabled by the Agent Manager integration baseline."
        },
        {
          "code": "mcp_dynamic_tool_calls_disabled",
          "zh-CN": "锁定版 MCP Scan 动态模式会执行真实工具调用；P3 仅复用其风险分类和描述净化契约，并强制使用 Gateway 元数据快照，禁用动态 tools/call。",
          "en-US": "The locked MCP Scan dynamic mode performs real tool calls; P3 only reuses its risk taxonomy and description sanitization contract, forces Gateway metadata snapshots, and disables dynamic tools/call."
        }
      ]
