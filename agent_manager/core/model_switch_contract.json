      "parameters": {}
    },
    "hermes": {
      "verification": "isolated_cli",
      "label": "Hermes",
      "protocol": "chat_completions",
      "files": [
        ".hermes/config.yaml",
        ".hermes/.env"
      ],
      "binary": "hermes",
      "source": "https://github.com/NousResearch/hermes-agent",
      "parameters": {
        "max_tokens": {
          "type": "integer",
          "min": 1,
          "max": 128000,
          "path": "model.max_tokens",
          "wire": "max_tokens",
          "condition": "model_output_limit"
        }
      },
      "config_root_env": "HERMES_HOME",
      "config_root_prefix": ".hermes",
      "parameter_versions": [
        "0.17.0"
