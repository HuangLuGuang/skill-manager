    },
    "openclaw": {
      "label": "OpenClaw",
      "protocol": "chat_completions",
      "files": [
        ".openclaw/openclaw.json"
      ],
      "binary": "openclaw",
      "source": "https://docs.openclaw.ai/gateway/configuration-reference",
      "parameters": {}
    },
    "pi": {
      "verification": "isolated_cli",
      "label": "Pi",
      "protocol": "chat_completions",
      "files": [
        ".pi/agent/settings.json",
        ".pi/agent/models.json"
      ],
      "binary": "pi",
      "source": "https://github.com/badlogic/pi-mono/tree/main/packages/coding-agent/docs",
