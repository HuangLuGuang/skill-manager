{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 demo/claude-code-api-hook/agent_guard_hook.py"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "skills",
        "hooks": [
          {
            "type": "command",
            "command": "python3 demo/claude-code-api-hook/agent_guard_hook.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 demo/claude-code-api-hook/agent_guard_hook.py"
          }
        ]
      }
    ]
  }
}
