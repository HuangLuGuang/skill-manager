# Local Docker Compose defaults. Build/load images, then copy this file to .env.
# For production, replace development credentials and enable secure startup;
# see docs/docker-deployment.md for signing-key provisioning.
# HTTP access port, saved by ./start.sh --port PORT and reused by upgrades.
HTTP_PORT=80
# Comma-separated DNS names/IP addresses used to access self-signed HTTPS.
TLS_HOSTS=localhost,127.0.0.1

# Backend
SECRET_KEY=change-me-in-production
ENFORCE_SECURE_STARTUP=false
# Empty creates a random initial password in the Backend data volume.
INITIAL_ADMIN_PASSWORD=
DEBUG=false

# Agent Manager API and signing
AGENT_MANAGER_BASE_URL=http://127.0.0.1:8080
# AGENT_MANAGER_DATA_DIR=data/
# Number of background submissions and analyzer tasks. One submission can run
# scanner, behavioral, deep scan, and an explicitly selected Sandbox in parallel.
AGENT_MANAGER_SCAN_WORKERS=2
AGENT_MANAGER_ANALYZER_WORKERS=8
# Blocking import preparation has separate capacity from ordinary API requests.
AGENT_MANAGER_IMPORT_WORKERS=2
# SkillSpector is a heavier subprocess, so it has its own global limit.
AGENT_MANAGER_SKILLSPECTOR_CONCURRENCY=2
AGENT_MANAGER_SIGNING_PRIVATE_KEY_PATH=/app/runtime/agent_manager/signing/skill-ed25519.pem
AUDIT_SIGNING_PRIVATE_KEY_PATH=/app/runtime/data/signing/audit-ed25519.pem
# Docker initializes a missing P-256 key in the persistent data volume and reuses it.
AIDR_POLICY_SIGNING_KEY_FILE=/app/runtime/data/signing/aidr-policy-p256.pem
SECURITY_AUDIT_EXPORT_PATH=/app/runtime/data/audit/security-audit.jsonl

# Agent demo model provider
AGNO_MODEL_BASE_URL=http://llm.dev-rs.com/v1
AGNO_API_KEY=sk-xxxxxx

# Agent Manager sandbox integration
AGENT_MANAGER_SANDBOX_RUNTIME=remote
AGENT_MANAGER_SANDBOX_URL=http://sandbox:8194
AGENT_MANAGER_SANDBOX_API_KEY=sandbox-change-me

# MCP outbound security
MCP_ALLOW_HTTP=false
# Comma-separated exact domains, wildcard domains, or CIDRs. Empty means any public address.
MCP_OUTBOUND_ALLOWLIST=
MCP_MAX_RESPONSE_KB=1024

# Built-in Agent Security Worker
# Generate with: printf 'amsw_%s\n' "$(openssl rand -hex 32)"
# The same value is read by Backend and the built-in Worker.
# This public development placeholder must be replaced for production.
AGENT_SECURITY_WORKER_TOKEN=amsw_local-development-only-change-before-production
AGENT_SECURITY_CONTROL_PLANE_URL=http://backend:8000/api/v1/agent-security
AGENT_SECURITY_WORKER_POLL_SECONDS=5

# Dedicated internal AI-Infra-Guard wrapper authentication. Generate with:
# printf 'aigs_%s\n' "$(openssl rand -hex 32)"
# Backend, Worker and the internal service share this development placeholder.
# Replace it for production; never commit a real token.
AIG_SCAN_SERVICE_TOKEN=aigs_local-development-only-change-before-production
AIG_SERVICE_URL=http://aig-scan-service:8093
AIG_SERVICE_TOKEN=${AIG_SCAN_SERVICE_TOKEN}
# For host-run Backend/Worker, use http://127.0.0.1:8093 and publish the service port.
# Also set AGENT_SECURITY_CONTROL_PLANE_URL to the host Backend's /api/v1/agent-security.
AIG_SCAN_SERVICE_MAX_JOBS=100
AIG_SCAN_SERVICE_TMPFS_SIZE=512m
AIG_SCAN_SERVICE_MEMORY_LIMIT=2g
AIG_SCAN_SERVICE_CPU_LIMIT=2.0

# Select an enabled gateway evaluator model when creating an Agent or LLM scan.

# Remote sandbox service
SANDBOX_SERVICE_BACKEND=nsjail
SANDBOX_SERVICE_ENFORCE_SECURE_STARTUP=${ENFORCE_SECURE_STARTUP}
