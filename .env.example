# Backend
SECRET_KEY=replace-with-at-least-32-random-characters
ENFORCE_SECURE_STARTUP=true
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
DEBUG=false

# Agent Manager API and signing
AGENT_MANAGER_BASE_URL=http://127.0.0.1:8080
# AGENT_MANAGER_DATA_DIR=data/
# Number of background submissions and analyzer tasks. One submission can run
# scanner, behavioral, deep scan, and an explicitly selected Sandbox in parallel.
AGENT_MANAGER_SCAN_WORKERS=2
AGENT_MANAGER_ANALYZER_WORKERS=8
# SkillSpector is a heavier subprocess, so it has its own global limit.
AGENT_MANAGER_SKILLSPECTOR_CONCURRENCY=2
AGENT_MANAGER_SIGNING_PRIVATE_KEY_PATH=/app/runtime/agent_manager/signing/skill-ed25519.pem
AUDIT_SIGNING_PRIVATE_KEY_PATH=/app/runtime/data/signing/audit-ed25519.pem
SECURITY_AUDIT_EXPORT_PATH=/app/runtime/data/audit/security-audit.jsonl

# Agent demo model provider
AGNO_MODEL_BASE_URL=http://llm.dev-rs.com/v1
AGNO_API_KEY=sk-xxxxxx

# Agent Manager sandbox integration
AGENT_MANAGER_SANDBOX_RUNTIME=remote
AGENT_MANAGER_SANDBOX_URL=http://sandbox:8194
AGENT_MANAGER_SANDBOX_API_KEY=replace-with-random-sandbox-key

# MCP outbound security
MCP_ALLOW_HTTP=false
# Comma-separated exact domains, wildcard domains, or CIDRs. Empty means any public address.
MCP_OUTBOUND_ALLOWLIST=
MCP_MAX_RESPONSE_KB=1024

# Remote sandbox service
SANDBOX_SERVICE_BACKEND=nsjail
SANDBOX_SERVICE_ENFORCE_SECURE_STARTUP=true
