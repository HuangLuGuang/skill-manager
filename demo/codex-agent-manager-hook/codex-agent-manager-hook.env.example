AGENT_MANAGER_VERIFIER_BASE_URL=http://127.0.0.1:8001
AGENT_MANAGER_VERIFIER_TOKEN=amat_replace_me
AGENT_ID=replace-with-bound-agent-id

# 使用英文冒号分隔多个追加目录；Codex 默认 Skill 目录始终会校验。
# AGENT_MANAGER_CODEX_SKILLS_DIRS=/Users/me/.agents/skills:/path/to/repo/.agents/skills

# 仅当 Agent Manager 服务端配置了同一个签名密钥时填写。
# AGENT_MANAGER_SIGNING_KEY=replace-with-server-signing-key
